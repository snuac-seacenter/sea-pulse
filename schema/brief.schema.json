{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sea-pulse-brief/v0",
  "title": "SEA Pulse 동남아 데일리 브리프 (하루 1건)",
  "type": "object",
  "required": ["schema", "date", "weekday", "headline", "regional", "countries", "countries_brief", "watch_next", "sources"],
  "additionalProperties": false,
  "$defs": {
    "code": { "enum": ["TH", "VN", "ID", "PH", "MY", "MM", "SG", "KH", "LA", "BN", "TL"] },
    "text": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
  },
  "properties": {
    "schema": { "const": "sea-pulse-brief/v0" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "weekday": { "enum": ["월", "화", "수", "목", "금", "토", "일"] },
    "title": { "type": "string" },
    "series": { "type": ["string", "null"] },
    "editor": { "type": ["string", "null"] },
    "headline": { "$ref": "#/$defs/text", "description": "오늘의 한 줄" },
    "regional": {
      "description": "아세안 역내 정세 (보통 5건, 중요도 순)",
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["title", "body", "countries"], "additionalProperties": false,
        "properties": {
          "title": { "$ref": "#/$defs/text" },
          "body": { "$ref": "#/$defs/text" },
          "point": { "type": ["string", "null"] },
          "countries": { "type": "array", "items": { "$ref": "#/$defs/code" }, "description": "관련 국가 코드. 역내 전체 사안이면 []" }
        }
      }
    },
    "special": {
      "description": "오늘의 특별 이슈. 없는 날은 null",
      "type": ["object", "null"], "required": ["title", "sections"],
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "sections": { "type": "array", "items": { "type": "object", "required": ["label", "text"],
          "properties": { "label": { "$ref": "#/$defs/text" }, "text": { "$ref": "#/$defs/text" } } } }
      }
    },
    "countries": {
      "description": "국가별 동향 정밀 분석(보통 6개국)",
      "type": "array",
      "items": {
        "type": "object", "required": ["code", "name", "paragraphs"], "additionalProperties": false,
        "properties": {
          "code": { "$ref": "#/$defs/code" }, "name": { "$ref": "#/$defs/text" },
          "update": { "type": ["string", "null"], "description": "예: 업데이트 · 8월 21~22일 / 오늘 신규 아님 · 8월 20일" },
          "paragraphs": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["field", "text"],
            "properties": { "field": { "$ref": "#/$defs/text" }, "text": { "$ref": "#/$defs/text" } } } },
          "point": { "type": ["string", "null"] },
          "next_check": { "type": ["string", "null"] }
        }
      }
    },
    "countries_brief": {
      "description": "나머지 국가 요약 표",
      "type": "array",
      "items": { "type": "object", "required": ["code", "name", "trend", "next_check"], "additionalProperties": false,
        "properties": { "code": { "$ref": "#/$defs/code" }, "name": { "type": "string" }, "trend": { "$ref": "#/$defs/text" }, "next_check": { "$ref": "#/$defs/text" } } }
    },
    "macro": {
      "type": ["object", "null"], "required": ["columns", "rows"],
      "properties": { "title": { "type": ["string", "null"] }, "columns": { "type": "array", "items": { "type": "string" } },
        "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } } }
    },
    "chronology": {
      "description": "지속 이슈 크로놀로지. id는 날짜가 바뀌어도 같은 이슈면 같은 값",
      "type": "array",
      "items": { "type": "object", "required": ["id", "issue", "events"], "additionalProperties": false,
        "properties": { "id": { "$ref": "#/$defs/id" }, "issue": { "$ref": "#/$defs/text" },
          "events": { "type": "array", "items": { "type": "object", "required": ["date", "text"],
            "properties": { "date": { "$ref": "#/$defs/text" }, "text": { "$ref": "#/$defs/text" } } } },
          "status": { "type": ["string", "null"] } } }
    },
    "asean_overview": { "type": "array", "items": { "type": "object", "required": ["text"],
      "properties": { "label": { "type": ["string", "null"] }, "text": { "$ref": "#/$defs/text" } } } },
    "research": { "type": "array", "items": { "type": "object", "required": ["source", "text"],
      "properties": { "source": { "type": "string" }, "author": { "type": ["string", "null"] }, "date": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] }, "url": { "type": ["string", "null"] }, "text": { "$ref": "#/$defs/text" } } } },
    "tracker": {
      "description": "트래커 업데이트. id는 날짜가 바뀌어도 고정",
      "type": "array",
      "items": { "type": "object", "required": ["id", "name", "judgement"],
        "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" }, "name_src": { "type": ["string", "null"] },
          "level": { "enum": ["red", "orange", "yellow", "green", null] },
          "change": { "enum": ["중요 변화", "변화 있음", "변화 없음", null] },
          "judgement": { "$ref": "#/$defs/text" }, "next_check": { "type": ["string", "null"] } } }
    },
    "watchlist": { "type": "array", "items": { "type": "object", "required": ["item"],
      "properties": { "item": { "type": "string" }, "stage": { "type": ["string", "null"] }, "note": { "type": ["string", "null"] } } } },
    "watch_next": { "type": "array", "items": { "$ref": "#/$defs/text" }, "description": "다음에 볼 것" },
    "verification_notes": { "type": "array", "items": { "type": "string" }, "description": "공개용 검증 노트(수치 상충, 일방 주장 등)" },
    "sources": { "type": "array", "items": { "type": "object", "required": ["text"],
      "properties": { "text": { "$ref": "#/$defs/text" }, "url": { "type": ["string", "null"] } } } },
    "pdf": { "type": ["string", "null"] },
    "internal_notes": { "type": "array", "items": { "type": "string" }, "description": "비공개. 사이트에 절대 나가지 않음" },
    "_public_edits": { "type": "array", "description": "시안 변환 시 공개본에서 고친 기록(초기 4건 전용)" }
  }
}
