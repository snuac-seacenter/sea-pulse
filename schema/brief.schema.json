{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sea-pulse-brief/v1",
  "title": "SEA Pulse 동남아 데일리 브리프 웹 JSON (sea-pulse-brief/v1)",
  "type": "object",
  "required": [
    "schema",
    "date",
    "weekday",
    "sections",
    "sources"
  ],
  "additionalProperties": false,
  "$defs": {
    "code": {
      "enum": [
        "TH",
        "VN",
        "ID",
        "PH",
        "MY",
        "MM",
        "SG",
        "KH",
        "LA",
        "BN",
        "TL"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "ntext": {
      "type": [
        "string",
        "null"
      ]
    },
    "table": {
      "type": "object",
      "required": [
        "columns",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "sea-pulse-brief/v1"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "weekday": {
      "enum": [
        "월",
        "화",
        "수",
        "목",
        "금",
        "토",
        "일"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ],
      "description": "예: 동남아 데일리 브리프"
    },
    "edition": {
      "type": [
        "string",
        "null"
      ],
      "description": "원문 판 이름. 예: SEA Pulse, SERIES Daily 구독자판"
    },
    "editor": {
      "type": [
        "string",
        "null"
      ]
    },
    "observation_cutoff": {
      "type": [
        "string",
        "null"
      ],
      "description": "예: 2026-11-10 23:59 KST"
    },
    "headline": {
      "type": [
        "string",
        "null"
      ],
      "description": "오늘의 한 줄. 없으면 null"
    },
    "pulse": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "description": "Today's Pulse / Executive Pulse 단락. 없으면 []"
    },
    "monitor": {
      "description": "지속 이슈 상태판(SEA Pulse Monitor, Tracker). 없으면 []",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue"
        ],
        "additionalProperties": false,
        "properties": {
          "issue_id": {
            "anyOf": [
              {
                "$ref": "#/$defs/id"
              },
              {
                "type": "null"
              }
            ]
          },
          "issue": {
            "$ref": "#/$defs/text"
          },
          "status": {
            "enum": [
              "NEW",
              "UP",
              "CONTINUITY",
              "DOWN",
              "WATCH",
              "IMPLEMENTED",
              null
            ]
          },
          "status_label": {
            "type": [
              "string",
              "null"
            ],
            "description": "원문 상태 표기(예: 변화 있음, RED)"
          },
          "level": {
            "enum": [
              "red",
              "orange",
              "yellow",
              "green",
              null
            ]
          },
          "stage": {
            "type": [
              "string",
              "null"
            ],
            "description": "최신 검증 단계(latest_verified_stage)"
          },
          "delta": {
            "type": [
              "string",
              "null"
            ],
            "description": "오늘의 변화·판단"
          },
          "next_trigger": {
            "type": [
              "string",
              "null"
            ]
          },
          "period": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "end": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "economic_signal": {
            "type": [
              "string",
              "null"
            ],
            "description": "관련 경제 신호(있을 때만)"
          }
        }
      }
    },
    "sections": {
      "description": "본문 블록. 원문 순서대로. 같은 type이 이어지면 웹페이지가 한 묶음으로 보여 줌",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "description": "regional(역내 정세 항목) | special(특별 이슈·특집) | country(국가별 동향) | country_brief(국가 요약 표의 한 행) | asean(ASEAN·대외관계) | theme(디지털·AI, 경제 포커스 등 주제) | deep_dive(심층) | macro(거시경제 표) | research(연구·정책 분석) | watchlist | other"
          },
          "heading": {
            "type": [
              "string",
              "null"
            ],
            "description": "묶음 제목을 원문 표기로 바꾸고 싶을 때(예: Day-of-Week Economic Focus)"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "lede": {
            "type": [
              "string",
              "null"
            ],
            "description": "제목 아래 요지 한 줄"
          },
          "countries": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/code"
            }
          },
          "issue_ids": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "update": {
            "type": [
              "string",
              "null"
            ],
            "description": "예: 업데이트 · 8월 21~22일"
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "text": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          },
          "table": {
            "anyOf": [
              {
                "$ref": "#/$defs/table"
              },
              {
                "type": "null"
              }
            ]
          },
          "point": {
            "type": [
              "string",
              "null"
            ]
          },
          "next_check": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "chronology": {
      "description": "지속 이슈 크로놀로지 / Compact Chronology. 이슈별 묶음 또는 날짜 표 하나(issue_id·issue null)",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "events"
        ],
        "additionalProperties": false,
        "properties": {
          "issue_id": {
            "anyOf": [
              {
                "$ref": "#/$defs/id"
              },
              {
                "type": "null"
              }
            ]
          },
          "issue": {
            "type": [
              "string",
              "null"
            ]
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "date",
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "date": {
                  "type": "string"
                },
                "text": {
                  "$ref": "#/$defs/text"
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "남은 판단 기준 등"
                }
              }
            }
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "bottom_line": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "watch_next": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "description": "다음에 볼 것 / What to Watch"
    },
    "verification_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ],
            "description": "본문 인용 번호. 예: S02"
          },
          "publisher": {
            "type": [
              "string",
              "null"
            ],
            "description": "기관·매체명. 예: Reuters, 인도네시아 재무부"
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "기사·문서 제목(원문 언어 그대로)"
          },
          "date": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "게재일·발행일 YYYY-MM-DD. 확인하지 못하면 null"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": [
              "string",
              "null"
            ],
            "description": "(예전 형식) 출처를 한 줄로 쓴 것. 새 브리프는 publisher·title·date를 쓴다"
          }
        },
        "anyOf": [
          {
            "required": [
              "text"
            ]
          },
          {
            "required": [
              "title"
            ]
          }
        ]
      }
    },
    "internal_notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "비공개. 사이트에 나가지 않음"
    },
    "_public_edits": {
      "type": "array"
    },
    "new_terms": {
      "type": "array",
      "description": "비공개. 독자에게 풀이가 필요한 새 약어·기관·인물 제안(웹 용어 풀이 목록 보강용)",
      "items": {
        "type": "object",
        "required": [
          "term",
          "desc"
        ],
        "additionalProperties": false,
        "properties": {
          "term": {
            "type": "string"
          },
          "desc": {
            "type": "string"
          }
        }
      }
    }
  }
}